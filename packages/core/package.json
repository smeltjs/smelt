{
  "name": "@smeltjs/core",
  "version": "0.7.0",
  "description": "Structure-aware, reversible, offline context optimization for AI coding agents.",
  "license": "Apache-2.0",
  "author": "mong-x",
  "homepage": "https://github.com/smeltjs/smelt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeltjs/smelt.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/smeltjs/smelt/issues",
  "keywords": [
    "llm",
    "context",
    "tokens",
    "tree-sitter",
    "agents",
    "compression",
    "prompt-cache",
    "offline"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks/guard-core": "./dist/hooks/guard-core.js",
    "./hooks/shims/claude-code": "./dist/hooks/shims/claude-code.js",
    "./hooks/shims/codex": "./dist/hooks/shims/codex.js",
    "./hooks/shims/gemini": "./dist/hooks/shims/gemini.js",
    "./hooks/shims/grok": "./dist/hooks/shims/grok.js",
    "./hooks/shims/hermes": "./dist/hooks/shims/hermes.js",
    "./hooks/shims/cursor": "./dist/hooks/shims/cursor.js",
    "./hooks/shims/cline": "./dist/hooks/shims/cline.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "smelt": "dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/inline-declaration-map-sources.mjs && node ../../scripts/bundle-grammars.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build && node ../../scripts/generate-third-party.mjs",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "web-tree-sitter": "~0.25.10"
  },
  "devDependencies": {
    "@smelt/guard-kit": "workspace:*",
    "@types/node": "^26.4.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
