{
  "name": "smelt-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter @smeltjs/site run typecheck",
    "lint": "oxlint --deny-warnings packages site/scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mutate": "node scripts/mutate.mjs",
    "generate:guards": "node scripts/mutate.mjs --write-guards",
    "generate:third-party": "node scripts/generate-third-party.mjs",
    "generate:skill": "node scripts/generate-skill.mjs",
    "generate:llms-txt": "node scripts/generate-llms-txt.mjs",
    "bench": "pnpm --filter @smeltjs/core run bench",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run mutate"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6"
  }
}
