dist/
node_modules/
.mutants/
pnpm-lock.yaml
assets/*.svg
.claude/
.remember/

# bench corpus — byte-exact committed tool outputs; formatting them would falsify them
packages/core/bench/corpus/

# the SkillPack — rendered byte-for-byte by scripts/generate-skill.mjs from the built
# SetupRecipe; a formatter's reflow would make the committed skill disagree with its
# own generator, and the guard that compares them would be referee to a formatting war.
/skills/

# the site's app sources are its own world — but its build-time generators are not:
# root verify runs site/scripts/facts-data.mjs (the site-facts guard spawns it), so the
# code verify executes is formatted and linted like everything else verify executes.
site/*
!site/scripts/

# guard scratch — isolated copies of `src` a guard makes and removes
packages/core/.guard-scratch/

# bench measurement logs — evidence artifacts written by the harness and committed
# verbatim; a formatter reflowing a committed log is editing the evidence
packages/core/bench/tier3-log/
packages/core/bench/ab-log/
