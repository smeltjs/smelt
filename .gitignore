node_modules/
dist/
coverage/
*.tsbuildinfo

# mutation runner scratch — see scripts/mutate.mjs
.mutants/

# bench corpus entries materialized at run time from a committed `<name>.json`
# reference (sha256-pinned) — see packages/core/bench/run.mjs
packages/core/bench/corpus/structural.ts
packages/core/bench/corpus/judge-log

.DS_Store

# bundled tree-sitter grammars — generated by scripts/bundle-grammars.mjs on build,
# shipped in the npm tarball via the "grammars" entry in packages/core/package.json
packages/core/grammars/
.claude/

# site — secrets and licensed Agent Kit reference material (read-only use, never committed)
site/.env.local
site/.env*.local
site/prompts/
site/recipes/
site/src/generated/

# guard scratch — isolated copies of `src` a guard makes and removes (see
# packages/core/test/guards/repo-map.test.ts)
packages/core/.guard-scratch/
